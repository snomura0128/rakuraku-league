{
  "name": "rakuraku-league",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "vercel-build": "next build",
    "dev": "next dev",
    "worker": "wrangler dev --local --config wrangler.worker.toml",
    "local:all": "concurrently -k -n FRONT,API -c green,cyan \"npm run dev\" \"npm run worker\"",
    "build:cf": "npx @cloudflare/next-on-pages@1",
    "build:cf:dev": "dotenv -e .env.development -- npx @cloudflare/next-on-pages@1",
    "build:cf:prod": "dotenv -e .env.production -- npx @cloudflare/next-on-pages@1",
    "d1:migrate:local": "wrangler d1 migrations apply rakuraku-league-local-db --local --config wrangler.worker.toml",
    "d1:migrate:dev": "wrangler d1 migrations apply rakuraku-league-dev-db-new --env dev --remote --config wrangler.worker.toml",
    "d1:migrate:prod": "wrangler d1 migrations apply rakuraku-league-prod-db-new --env production --remote --config wrangler.worker.toml",
    "deploy:pages:dev": "npm run build:cf:dev && wrangler pages deploy .vercel/output/static --project-name rakuraku-league-dev-pages --branch dev",
    "deploy:pages:prod": "npm run build:cf:prod && wrangler pages deploy .vercel/output/static --project-name rakuraku-league-prod-pages --branch main",
    "deploy:worker:dev": "wrangler deploy --config wrangler.worker.toml --env dev",
    "deploy:worker:prod": "wrangler deploy --config wrangler.worker.toml --env production",
    "worker:remote:dev": "wrangler dev --remote --config wrangler.worker.toml"
  },
  "dependencies": {
    "@cloudflare/d1": "^1.4.1",
    "@cloudflare/next-on-pages": "^1.13.13",
    "@cloudflare/workers-types": "^4.20250822.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/three": "^0.179.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.4",
    "hono": "^4.9.4",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.539.0",
    "next": "14.2.18",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.179.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.0.1",
    "concurrently": "^9.2.0",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5",
    "wrangler": "^4.30.0"
  }
}
